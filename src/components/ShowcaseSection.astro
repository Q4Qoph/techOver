---
<section class="py-24 bg-white text-slate-900 relative overflow-hidden" id="showcase">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    {/* Headings */}
    <div class="text-center mb-10">
      <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight text-slate-900 leading-tight">
        Grow your business
      </h2>
      <p class="mt-4 text-lg md:text-xl text-slate-550 font-normal max-w-2xl mx-auto">
        You deserve a website that works for you.
      </p>
    </div>

    {/* All 8 Squarespace Pill Category Buttons (Static Placeholders) */}
    <div class="flex justify-center flex-wrap gap-2 md:gap-3 mb-16 select-none max-w-4xl mx-auto">
      <span class="px-5 py-2.5 rounded-full text-xs md:text-sm font-semibold bg-slate-100 text-slate-600 border border-transparent">
        Services
      </span>
      <span class="px-5 py-2.5 rounded-full text-xs md:text-sm font-semibold bg-slate-100 text-slate-600 border border-transparent">
        Online Store
      </span>
      <span class="px-5 py-2.5 rounded-full text-xs md:text-sm font-semibold bg-slate-900 text-white shadow-sm border border-transparent">
        Invoicing
      </span>
      <span class="px-5 py-2.5 rounded-full text-xs md:text-sm font-semibold bg-slate-100 text-slate-600 border border-transparent">
        Scheduling
      </span>
      <span class="px-5 py-2.5 rounded-full text-xs md:text-sm font-semibold bg-slate-100 text-slate-600 border border-transparent">
        Donations
      </span>
      <span class="px-5 py-2.5 rounded-full text-xs md:text-sm font-semibold bg-slate-100 text-slate-600 border border-transparent">
        Memberships
      </span>
      <span class="px-5 py-2.5 rounded-full text-xs md:text-sm font-semibold bg-slate-100 text-slate-600 border border-transparent">
        Blog
      </span>
      <span class="px-5 py-2.5 rounded-full text-xs md:text-sm font-semibold bg-slate-100 text-slate-600 border border-transparent">
        Portfolio
      </span>
    </div>

    {/* Horizontal Slider Viewport with Side Peeking Cards */}
    <div class="relative overflow-visible w-full py-4">
      <div class="slider-viewport overflow-visible max-w-5xl mx-auto">
        <div class="slider-track flex gap-8 transition-transform duration-500 ease-out motion-reduce:transition-none" id="slider-track">
          
          {/* Card 0: FDK Elevators */}
          <div class="showcase-card w-[88vw] md:w-[760px] shrink-0 bg-slate-950 text-white rounded-[32px] p-6 md:p-10 border border-slate-800 shadow-2xl flex flex-col justify-between transition-all duration-500 ease-in-out transform" data-index="0">
            <div>
              <div class="mb-6 text-left">
                <span class="text-xs uppercase tracking-widest text-blue-400 font-bold block mb-1">Corporate &amp; Services</span>
                <h3 class="text-2xl md:text-3xl font-bold text-white mb-2">FDK Elevators</h3>
                <p class="text-xs md:text-sm text-slate-400 font-light max-w-2xl leading-relaxed">
                  Industrial engineering and maintenance AMC portal. Features comprehensive service tables, dynamic request forms, and localized SEO keyword mapping.
                </p>
              </div>

              {/* Browser mockup */}
              <div class="relative bg-slate-900 rounded-2xl overflow-hidden border border-slate-800 shadow-2xl aspect-[16/9] w-full group">
                <div class="bg-slate-850 px-4 py-2 border-b border-slate-800 flex items-center justify-between">
                  <div class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-red-500 inline-block"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-yellow-500 inline-block"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
                  </div>
                  <div class="bg-slate-950 rounded text-[9px] text-slate-500 px-3 py-0.5 font-mono truncate max-w-[150px] text-center border border-slate-900">
                    fdkelevators.com
                  </div>
                  <div class="w-8"></div>
                </div>
                
                {/* Viewport */}
                <div class="relative w-full h-[calc(100%-29px)] overflow-hidden bg-slate-950">
                  <img src="/showcase-fdk.png" alt="FDK Elevators Website Preview" class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-102" />
                  <div class="absolute inset-0 bg-slate-950/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center backdrop-blur-[1px]">
                    <a href="https://www.fdkelevators.com/" target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 bg-white text-slate-950 font-bold text-xs rounded-full shadow-2xl hover:scale-105 transition-all duration-300 flex items-center gap-1.5">
                      <span>Visit Live Site</span>
                      <span class="text-[10px]">↗</span>
