                {/* Viewport */}
                <div class="relative w-full h-[calc(100%-29px)] overflow-hidden bg-slate-950">
                  <img src="/showcase-konastone.png" alt="Konastone Autos and Imports vehicle listings website preview" class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-102" />
