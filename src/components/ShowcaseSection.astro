            </div>
          </div>

        </div>
      </div>
      
      {/* Navigation Controls */}
      <div class="flex justify-between items-center mt-12 max-w-sm mx-auto select-none">
        <button id="prev-btn" class="w-12 h-12 rounded-full border border-slate-200 bg-white text-slate-800 flex items-center justify-center hover:bg-slate-50 active:scale-95 transition shadow-sm cursor-pointer" aria-label="Previous Project">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
        </button>
        
        {/* Dot Indicators */}
        <div class="flex gap-2.5" id="dots-container">
          <button class="dot w-2.5 h-2.5 rounded-full bg-slate-200 transition-all duration-300 cursor-pointer" data-slide="0" aria-label="Project 1"></button>
          <button class="dot w-2.5 h-2.5 rounded-full bg-slate-200 transition-all duration-300 cursor-pointer" data-slide="1" aria-label="Project 2"></button>
          <button class="dot w-2.5 h-2.5 rounded-full bg-slate-200 transition-all duration-300 cursor-pointer" data-slide="2" aria-label="Project 3"></button>
        </div>
        
        <button id="next-btn" class="w-12 h-12 rounded-full border border-slate-200 bg-white text-slate-800 flex items-center justify-center hover:bg-slate-50 active:scale-95 transition shadow-sm cursor-pointer" aria-label="Next Project">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  function setupSlider() {
    const track = document.getElementById('slider-track');
    const cards = document.querySelectorAll('.showcase-card');
    const dots = document.querySelectorAll('.dot');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');

    if (!track || cards.length === 0) return;

    // Default to the middle card (index 1) on load
    let currentIndex = 1;
    const cardCount = cards.length;
    const gap = 32; // match gap-8 (32px)

    function updateSlider() {
      const viewportWidth = track.parentElement.clientWidth;
      const cardWidth = cards[0].clientWidth;
      
      // Calculate translation offset to center the active card
      const offset = (viewportWidth - cardWidth) / 2 - currentIndex * (cardWidth + gap);
      track.style.transform = `translateX(${offset}px)`;

      // Update dots
      dots.forEach((dot, idx) => {
        if (idx === currentIndex) {
          dot.classList.remove('bg-slate-200');
          dot.classList.add('bg-slate-900', 'w-6');
        } else {
          dot.classList.remove('bg-slate-900', 'w-6');
          dot.classList.add('bg-slate-200');
        }
      });

      // Update card visual emphasis (scale & opacity of center card)
      cards.forEach((card, idx) => {
        if (idx === currentIndex) {
          card.style.opacity = '1';
          card.style.transform = 'scale(1)';
        } else {
          card.style.opacity = '0.4';
          card.style.transform = 'scale(0.95)';
        }
      });
    }

    // Dot indicators click
    dots.forEach(dot => {
      dot.addEventListener('click', () => {
        currentIndex = parseInt(dot.getAttribute('data-slide') || '1');
        updateSlider();
      });
    });

    // Arrow buttons click with infinite circular looping
    prevBtn?.addEventListener('click', () => {
      currentIndex = (currentIndex - 1 + cardCount) % cardCount;
      updateSlider();
    });

    nextBtn?.addEventListener('click', () => {
      currentIndex = (currentIndex + 1) % cardCount;
      updateSlider();
    });

    // Touch events for mobile swipe gestures
    let touchStartX = 0;
    let touchEndX = 0;

    track.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    track.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
    }, { passive: true });

    function handleSwipe() {
      const swipeThreshold = 50;
      const diffX = touchEndX - touchStartX;
      
      if (Math.abs(diffX) > swipeThreshold) {
        if (diffX < 0) {
          // Swipe left -> Next card
          currentIndex = (currentIndex + 1) % cardCount;
        } else {
          // Swipe right -> Prev card
          currentIndex = (currentIndex - 1 + cardCount) % cardCount;
        }
        updateSlider();
      }
    }

    // Handle window resize dynamically to adjust centering offset
    window.addEventListener('resize', updateSlider);

    // Initial positioning
    updateSlider();
  }

  // Setup on startup
  setupSlider();

  // Astro page transitions support
  document.addEventListener('astro:after-swap', setupSlider);
</script>
