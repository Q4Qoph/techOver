---
import ShowcaseCard from './ShowcaseCard.astro';
import { showcaseProjects } from '../data/showcaseProjects';
---

<section class="py-24 bg-white text-slate-900 relative overflow-hidden" id="showcase" aria-labelledby="showcase-title">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-10">
      <h2 id="showcase-title" class="text-3xl md:text-5xl font-extrabold tracking-tight text-slate-900 leading-tight text-balance">
        Grow your business
      </h2>
      <p class="mt-4 text-lg md:text-xl text-slate-550 font-normal max-w-2xl mx-auto">
        You deserve a website that works for you.
      </p>
    </div>

    <div class="relative overflow-visible w-full py-4">
      <div class="slider-viewport overflow-visible max-w-5xl mx-auto" role="region" aria-label="Featured website projects">
        <div class="slider-track flex items-start md:items-stretch gap-8 transition-transform duration-500 ease-out motion-reduce:transition-none" id="slider-track">
          {showcaseProjects.map((project, index) => <ShowcaseCard project={project} index={index} />)}
        </div>
      </div>

      <div class="flex justify-between items-center mt-12 max-w-sm mx-auto select-none">
        <button id="prev-btn" class="w-12 h-12 rounded-full border border-slate-200 bg-white text-slate-800 flex items-center justify-center hover:bg-slate-50 active:scale-95 transition-[transform,background-color] shadow-sm cursor-pointer" aria-label="Previous project">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
        </button>

        <div class="flex gap-2.5" id="dots-container" role="group" aria-label="Choose a project">
          {showcaseProjects.map((project, index) => (
            <button
              class:list={[
                'dot h-2.5 rounded-full transition-[width,background-color] duration-300 cursor-pointer',
                index === 1 ? 'bg-slate-900 w-6' : 'bg-slate-200 w-2.5',
              ]}
              data-slide={index}
              aria-label={`Show ${project.title}`}
              aria-pressed={index === 1 ? 'true' : 'false'}
            ></button>
          ))}
        </div>

        <button id="next-btn" class="w-12 h-12 rounded-full border border-slate-200 bg-white text-slate-800 flex items-center justify-center hover:bg-slate-50 active:scale-95 transition-[transform,background-color] shadow-sm cursor-pointer" aria-label="Next project">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  let cleanupSlider: (() => void) | undefined;

  function setupSlider() {
    cleanupSlider?.();

    const track = document.getElementById('slider-track');
    const showcase = document.getElementById('showcase');
    const originalSlides = track
      ? Array.from(track.querySelectorAll<HTMLElement>('.showcase-card'))
        .filter((slide) => slide.dataset.sliderClone !== 'true')
      : [];
    const dots = showcase?.querySelectorAll<HTMLButtonElement>('.dot') ?? [];
    const prevBtn = showcase?.querySelector<HTMLButtonElement>('#prev-btn');
    const nextBtn = showcase?.querySelector<HTMLButtonElement>('#next-btn');

    if (!track || originalSlides.length < 2) return;

    const slideCount = originalSlides.length;
    const firstClone = originalSlides[0].cloneNode(true) as HTMLElement;
    const lastClone = originalSlides[slideCount - 1].cloneNode(true) as HTMLElement;

    [firstClone, lastClone].forEach((clone) => {
      clone.dataset.sliderClone = 'true';
      clone.setAttribute('aria-hidden', 'true');
      clone.setAttribute('inert', '');
    });

    track.prepend(lastClone);
    track.append(firstClone);

    const slides = Array.from(track.children) as HTMLElement[];
    const viewport = track.parentElement;
    let currentPosition = Math.min(2, slideCount);
    let isTransitioning = false;
    let transitionTimer: number | undefined;

    function logicalIndex() {
      return (currentPosition - 1 + slideCount) % slideCount;
    }

    function updateTransform() {
      if (!viewport || !track) return;

      const viewportWidth = viewport.clientWidth;
      const cardWidth = slides[0].clientWidth;
      const gap = Number.parseFloat(window.getComputedStyle(track).columnGap) || 0;
      const offset = (viewportWidth - cardWidth) / 2 - currentPosition * (cardWidth + gap);
      track.style.transform = `translateX(${offset}px)`;
    }

    function updateIndicators() {
      const activeIndex = logicalIndex();
      dots.forEach((dot, index) => {
        const isActive = index === activeIndex;
        dot.classList.toggle('bg-slate-900', isActive);
        dot.classList.toggle('w-6', isActive);
        dot.classList.toggle('bg-slate-200', !isActive);
        dot.classList.toggle('w-2.5', !isActive);
        dot.setAttribute('aria-pressed', String(isActive));
      });
    }

    function updateEmphasis() {
      slides.forEach((slide, index) => {
        slide.style.opacity = index === currentPosition ? '1' : '0.4';
        slide.style.transform = index === currentPosition ? 'scale(1)' : 'scale(0.95)';
      });
    }

    function updateSlider() {
      updateTransform();
      updateIndicators();
      updateEmphasis();
    }

    function finishTransition() {
      if (!isTransitioning || !track) return;

      isTransitioning = false;
      if (transitionTimer !== undefined) {
        window.clearTimeout(transitionTimer);
        transitionTimer = undefined;
      }

      let snapToPosition: number | undefined;
      if (currentPosition === 0) snapToPosition = slideCount;
      if (currentPosition === slideCount + 1) snapToPosition = 1;

      if (snapToPosition !== undefined) {
        currentPosition = snapToPosition;
        track.style.transition = 'none';
        updateSlider();
        track.getBoundingClientRect();
        track.style.transition = '';
      }
    }

    function moveTo(position: number) {
      if (isTransitioning) return;

      currentPosition = position;
      isTransitioning = true;
      updateSlider();

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        finishTransition();
      } else {
        transitionTimer = window.setTimeout(finishTransition, 650);
      }
    }

    function handleTransitionEnd(event: TransitionEvent) {
      if (event.target === track && event.propertyName === 'transform') {
        finishTransition();
      }
    }

    function handleDotClick(event: MouseEvent) {
      if (isTransitioning) return;

      const dot = event.currentTarget as HTMLButtonElement;
      const targetIndex = Number.parseInt(dot.dataset.slide ?? '', 10);
      if (!Number.isInteger(targetIndex) || targetIndex < 0 || targetIndex >= slideCount) return;

      const activeIndex = logicalIndex();
      if (targetIndex === activeIndex) return;
      if (activeIndex === slideCount - 1 && targetIndex === 0) {
        moveTo(slideCount + 1);
      } else if (activeIndex === 0 && targetIndex === slideCount - 1) {
        moveTo(0);
      } else {
        moveTo(targetIndex + 1);
      }
    }

    function handleNext() {
      moveTo(currentPosition + 1);
    }

    function handlePrevious() {
      moveTo(currentPosition - 1);
    }

    let touchStartX = 0;
    function handleTouchStart(event: TouchEvent) {
      touchStartX = event.changedTouches[0]?.screenX ?? 0;
    }

    function handleTouchEnd(event: TouchEvent) {
      const touchEndX = event.changedTouches[0]?.screenX ?? 0;
      const difference = touchEndX - touchStartX;
      if (Math.abs(difference) <= 50) return;

      if (difference < 0) handleNext();
      else handlePrevious();
    }

    function handleResize() {
      updateTransform();
    }

    track.addEventListener('transitionend', handleTransitionEnd);
    track.addEventListener('touchstart', handleTouchStart, { passive: true });
    track.addEventListener('touchend', handleTouchEnd, { passive: true });
    dots.forEach((dot) => dot.addEventListener('click', handleDotClick));
    prevBtn?.addEventListener('click', handlePrevious);
    nextBtn?.addEventListener('click', handleNext);
    window.addEventListener('resize', handleResize);

    track.style.transition = 'none';
    updateSlider();
    track.getBoundingClientRect();
    window.requestAnimationFrame(() => {
      track.style.transition = '';
    });

    const cleanup = () => {
      if (transitionTimer !== undefined) window.clearTimeout(transitionTimer);
      track.removeEventListener('transitionend', handleTransitionEnd);
      track.removeEventListener('touchstart', handleTouchStart);
      track.removeEventListener('touchend', handleTouchEnd);
      dots.forEach((dot) => dot.removeEventListener('click', handleDotClick));
      prevBtn?.removeEventListener('click', handlePrevious);
      nextBtn?.removeEventListener('click', handleNext);
      window.removeEventListener('resize', handleResize);
      firstClone.remove();
      lastClone.remove();
      if (cleanupSlider === cleanup) cleanupSlider = undefined;
    };

    cleanupSlider = cleanup;
  }

  function cleanupBeforeSwap() {
    cleanupSlider?.();
  }

  setupSlider();
  document.addEventListener('astro:before-swap', cleanupBeforeSwap);
  document.addEventListener('astro:after-swap', setupSlider);
</script>
