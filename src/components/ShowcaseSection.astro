            <div>
              <div class="mb-6 text-left">
                <span class="text-xs uppercase tracking-widest text-amber-400 font-bold block mb-1">Luxury Showroom Portfolio</span>
                <h3 class="text-2xl md:text-3xl font-bold text-white mb-2">Velora Doors</h3>
