---
---
<section class="py-24 bg-slate-900 text-white relative overflow-hidden" id="showcase">
  {/* Decorative background grid and glow */}
  <div class="absolute inset-0 opacity-10 bg-[linear-gradient(to_right,#1e293b_1px,transparent_1px),linear-gradient(to_bottom,#1e293b_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>
  <div class="absolute top-1/4 left-1/4 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-1/4 right-1/4 translate-x-1/2 translate-y-1/2 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <span class="px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-semibold tracking-wide uppercase">
        Proof of Work
      </span>
      <h2 class="mt-4 text-3xl md:text-4xl font-extrabold tracking-tight">
        Interactive SME Showcase
      </h2>
      <p class="mt-4 text-lg text-slate-400 max-w-2xl mx-auto">
        Explore live niche preview layouts built for maximum conversion speed and M-Pesa checkout readiness.
      </p>
    </div>

    <div class="grid lg:grid-cols-3 md:grid-cols-2 gap-8">
      {/* Showcase 1: Salon & Spa */}
      <div class="group relative bg-slate-800/40 rounded-2xl p-6 border border-slate-700/50 hover:border-pink-500/30 transition-all duration-300 hover:shadow-xl hover:shadow-pink-500/5 flex flex-col justify-between">
        <div>
          {/* Tags */}
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-2.5 py-0.5 rounded-full bg-pink-500/10 border border-pink-500/20 text-pink-400 text-xs font-semibold">
              ⚡ 0.2s Load Time
            </span>
            <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold">
              WhatsApp Bookings
            </span>
          </div>

          {/* Browser frame representation */}
          <div class="relative bg-slate-950 rounded-xl overflow-hidden border border-slate-800 shadow-2xl mb-6">
            <div class="bg-slate-900/90 px-3 py-2 border-b border-slate-800 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-red-500/80 inline-block"></span>
              <span class="w-2 h-2 rounded-full bg-yellow-500/80 inline-block"></span>
              <span class="w-2 h-2 rounded-full bg-green-500/80 inline-block"></span>
              <div class="bg-slate-950 rounded text-[9px] text-slate-500 px-2 py-0.5 flex-grow text-center font-mono truncate max-w-[140px] mx-auto">
                rehemaspa.co.ke
              </div>
            </div>
            
            {/* Salon mini site mockup */}
            <div class="h-44 bg-pink-50/5 p-4 flex flex-col justify-between relative overflow-hidden text-left">
              <div>
                <div class="h-1.5 w-12 bg-pink-400/30 rounded mb-3"></div>
                <h4 class="text-sm font-bold text-pink-200">Rehema Hair &amp; Spa</h4>
                <p class="text-[9px] text-pink-300/70 mt-1 max-w-[160px]">Nairobi's Premium Bridal and Wellness Sanctuary.</p>
              </div>
              <div class="flex gap-2 items-center">
                <div class="px-2.5 py-1.5 bg-pink-500 hover:bg-pink-600 text-white rounded text-[9px] font-bold shadow-md cursor-pointer transition">
                  Book appointment
                </div>
                <div class="w-5 h-5 rounded-full bg-green-500 flex items-center justify-center text-[10px] text-white">
                  💬
                </div>
              </div>
              <div class="absolute right-2 top-8 w-16 h-16 rounded-full bg-gradient-to-tr from-pink-500/20 to-purple-500/20 blur-sm"></div>
            </div>
          </div>

          <h3 class="text-lg font-bold text-slate-100">Salon &amp; Spa Preview</h3>
          <p class="mt-2 text-slate-400 text-sm leading-relaxed">
            A boutique landing page designed to turn browsing traffic into bookings. The floating WhatsApp widget handles automated booking flows seamlessly.
          </p>
        </div>
        <div class="mt-6">
          <a href="https://wa.me/254798361771?text=Hi%20Fredie,%20I%20want%20to%20see%20the%20Salon%20and%20Spa%20demo." class="inline-flex items-center gap-1 text-sm font-bold text-pink-400 hover:text-pink-300 transition group/link">
            Request Demo Layout
            <span class="transition-transform group-hover/link:translate-x-1">→</span>
          </a>
        </div>
      </div>

      {/* Showcase 2: E-commerce Boutique */}
      <div class="group relative bg-slate-800/40 rounded-2xl p-6 border border-slate-700/50 hover:border-emerald-500/30 transition-all duration-300 hover:shadow-xl hover:shadow-emerald-500/5 flex flex-col justify-between">
        <div>
          {/* Tags */}
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold">
              ⚡ 0.3s Load Time
            </span>
            <span class="px-2.5 py-0.5 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-semibold">
              M-Pesa SDK Ready
            </span>
          </div>

          {/* Browser frame representation */}
          <div class="relative bg-slate-950 rounded-xl overflow-hidden border border-slate-800 shadow-2xl mb-6">
            <div class="bg-slate-900/90 px-3 py-2 border-b border-slate-800 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-red-500/80 inline-block"></span>
              <span class="w-2 h-2 rounded-full bg-yellow-500/80 inline-block"></span>
              <span class="w-2 h-2 rounded-full bg-green-500/80 inline-block"></span>
              <div class="bg-slate-950 rounded text-[9px] text-slate-500 px-2 py-0.5 flex-grow text-center font-mono truncate max-w-[140px] mx-auto">
                kikapu.techover.pro
              </div>
            </div>
            
            {/* E-commerce mini site mockup */}
            <div class="h-44 bg-emerald-950/20 p-4 flex flex-col justify-between relative overflow-hidden text-left">
              <div class="flex justify-between items-center">
                <span class="text-[9px] font-bold text-slate-300">Kikapu Trendz</span>
                <span class="text-[8px] bg-emerald-500/20 text-emerald-300 px-1 rounded">🛒 3 items</span>
              </div>
              
              <div class="grid grid-cols-2 gap-2 my-2">
                <div class="bg-slate-900/80 p-1.5 rounded border border-slate-800 text-[8px]">
                  <div class="h-8 bg-slate-800 rounded mb-1 flex items-center justify-center text-[12px]">👟</div>
                  <div class="font-semibold text-slate-200">Urban Sneakers</div>
                  <div class="text-emerald-400 font-bold">KES 3,500</div>
                </div>
                <div class="bg-slate-900/80 p-1.5 rounded border border-slate-800 text-[8px]">
                  <div class="h-8 bg-slate-800 rounded mb-1 flex items-center justify-center text-[12px]">🎒</div>
                  <div class="font-semibold text-slate-200">Urban Backpack</div>
                  <div class="text-emerald-400 font-bold">KES 2,200</div>
                </div>
              </div>
              
              <div class="w-full py-1 bg-emerald-500 text-white rounded text-[8px] font-black text-center cursor-pointer transition flex items-center justify-center gap-1">
                <span>🟢</span> Pay via M-PESA
              </div>
            </div>
          </div>

          <h3 class="text-lg font-bold text-slate-100">E-Commerce Boutique</h3>
          <p class="mt-2 text-slate-400 text-sm leading-relaxed">
            A fast visual catalog geared for high volume sales. Fully set up for M-Pesa STK Push payment flow, triggering instant confirmation.
          </p>
        </div>
        <div class="mt-6">
          <a href="https://wa.me/254798361771?text=Hi%20Fredie,%20I%20want%20to%20see%20the%20E-Commerce%20demo." class="inline-flex items-center gap-1 text-sm font-bold text-emerald-400 hover:text-emerald-300 transition group/link">
            Request Demo Layout
            <span class="transition-transform group-hover/link:translate-x-1">→</span>
          </a>
        </div>
      </div>

      {/* Showcase 3: Professional Consultant */}
      <div class="group relative bg-slate-800/40 rounded-2xl p-6 border border-slate-700/50 hover:border-blue-500/30 transition-all duration-300 hover:shadow-xl hover:shadow-blue-500/5 flex flex-col justify-between">
        <div>
          {/* Tags */}
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-2.5 py-0.5 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-semibold">
              ⚡ 0.3s Load Time
            </span>
            <span class="px-2.5 py-0.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-semibold">
              SEO Ranked #1
            </span>
          </div>

          {/* Browser frame representation */}
          <div class="relative bg-slate-950 rounded-xl overflow-hidden border border-slate-800 shadow-2xl mb-6">
            <div class="bg-slate-900/90 px-3 py-2 border-b border-slate-800 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-red-500/80 inline-block"></span>
              <span class="w-2 h-2 rounded-full bg-yellow-500/80 inline-block"></span>
              <span class="w-2 h-2 rounded-full bg-green-500/80 inline-block"></span>
              <div class="bg-slate-950 rounded text-[9px] text-slate-500 px-2 py-0.5 flex-grow text-center font-mono truncate max-w-[140px] mx-auto">
                apexadvisory.co.ke
              </div>
            </div>
            
            {/* Consultant mini site mockup */}
            <div class="h-44 bg-blue-950/20 p-4 flex flex-col justify-between relative overflow-hidden text-left">
              <div>
                <div class="flex justify-between items-center mb-2">
                  <div class="h-2 w-10 bg-blue-500/30 rounded"></div>
                  <div class="h-2 w-6 bg-slate-500/30 rounded"></div>
                </div>
                <h4 class="text-xs font-black text-slate-200">Apex Advisory Group</h4>
                <p class="text-[8px] text-slate-400 mt-1 max-w-[150px]">Scale your SME operations with expert corporate consulting.</p>
              </div>
              
              <div class="bg-slate-900/60 p-2 rounded border border-slate-800/80 text-[8px] my-1">
                <div class="text-[7px] text-slate-500 uppercase tracking-wider font-semibold">Book Free Session</div>
                <div class="h-3.5 bg-slate-950 rounded my-1 border border-slate-800"></div>
                <div class="h-3.5 bg-blue-600 text-white rounded text-[7px] flex items-center justify-center font-bold">Submit Form</div>
              </div>
            </div>
          </div>

          <h3 class="text-lg font-bold text-slate-100">Professional Consultant</h3>
          <p class="mt-2 text-slate-400 text-sm leading-relaxed">
            High-contrast layout focused on authority building. Equipped with Google Search structured schema to capture local client searches directly.
          </p>
        </div>
        <div class="mt-6">
          <a href="https://wa.me/254798361771?text=Hi%20Fredie,%20I%20want%20to%20see%20the%20Consultant%20demo." class="inline-flex items-center gap-1 text-sm font-bold text-blue-400 hover:text-blue-300 transition group/link">
            Request Demo Layout
            <span class="transition-transform group-hover/link:translate-x-1">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
