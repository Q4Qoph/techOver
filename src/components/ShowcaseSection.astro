                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>

          {/* Card 2: Velora Doors */}
          <div class="showcase-card w-[88vw] md:w-[760px] shrink-0 bg-slate-950 text-white rounded-[32px] p-6 md:p-10 border border-slate-800 shadow-2xl flex flex-col justify-between transition-all duration-500 ease-in-out transform" data-index="2">
            <div>
              <div class="mb-6 text-left">
                <span class="text-xs uppercase tracking-widest text-amber-400 font-bold block mb-1">Luxury Showroom Portfolio</span>
                <h3 class="text-2xl md:text-3xl font-bold text-white mb-2">Velora Doors</h3>
                <p class="text-xs md:text-sm text-slate-400 font-light max-w-2xl leading-relaxed">
                  Bespoke wood carving and luxury entry door portfolio. Styled with a premium dark-gold aesthetic optimized for architects and high-end developers.
                </p>
              </div>

              {/* Browser mockup */}
              <div class="relative bg-slate-900 rounded-2xl overflow-hidden border border-slate-800 shadow-2xl aspect-[16/9] w-full group">
                <div class="bg-slate-850 px-4 py-2 border-b border-slate-800 flex items-center justify-between">
                  <div class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-red-500 inline-block"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-yellow-500 inline-block"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
                  </div>
                  <div class="bg-slate-950 rounded text-[9px] text-slate-500 px-3 py-0.5 font-mono truncate max-w-[150px] text-center border border-slate-900">
                    veloradoors.com
                  </div>
                  <div class="w-8"></div>
                </div>
                
                {/* Viewport */}
                <div class="relative w-full h-[calc(100%-29px)] overflow-hidden bg-slate-950">
                  <img src="/showcase-velora.png" alt="Velora Doors Website Preview" class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-102" />
                  <div class="absolute inset-0 bg-slate-950/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center backdrop-blur-[1px]">
                    <a href="https://veloradoors.com/" target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 bg-white text-slate-950 font-bold text-xs rounded-full shadow-2xl hover:scale-105 transition-all duration-300 flex items-center gap-1.5">
                      <span>Visit Live Site</span>
                      <span class="text-[10px]">↗</span>
                    </a>
                  </div>
                </div>
