              </div>
            </div>
          </div>

        </div>
      </div>
      
      {/* Navigation Controls */}
      <div class="flex justify-between items-center mt-12 max-w-sm mx-auto select-none">
        <button id="prev-btn" class="w-12 h-12 rounded-full border border-slate-200 bg-white text-slate-800 flex items-center justify-center hover:bg-slate-50 active:scale-95 transition shadow-sm cursor-pointer" aria-label="Previous Project">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
        </button>
        
        {/* Dot Indicators */}
        <div class="flex gap-2.5" id="dots-container">
          <button class="dot w-2.5 h-2.5 rounded-full bg-slate-200 transition-all duration-300 cursor-pointer" data-slide="0" aria-label="Project 1"></button>
          <button class="dot w-2.5 h-2.5 rounded-full bg-slate-200 transition-all duration-300 cursor-pointer" data-slide="1" aria-label="Project 2"></button>
          <button class="dot w-2.5 h-2.5 rounded-full bg-slate-200 transition-all duration-300 cursor-pointer" data-slide="2" aria-label="Project 3"></button>
          <button class="dot w-2.5 h-2.5 rounded-full bg-slate-200 transition-all duration-300 cursor-pointer" data-slide="3" aria-label="Project 4"></button>
        </div>
        
        <button id="next-btn" class="w-12 h-12 rounded-full border border-slate-200 bg-white text-slate-800 flex items-center justify-center hover:bg-slate-50 active:scale-95 transition shadow-sm cursor-pointer" aria-label="Next Project">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  let cleanupSlider: (() => void) | undefined;

  function setupSlider() {
    cleanupSlider?.();

    const track = document.getElementById('slider-track');
    const showcase = document.getElementById('showcase');
    const originalCards = track
      ? Array.from(track.querySelectorAll<HTMLElement>('.showcase-card'))
        .filter((card) => card.dataset.sliderClone !== 'true')
      : [];
    const dots = showcase?.querySelectorAll<HTMLButtonElement>('.dot') ?? [];
    const prevBtn = showcase?.querySelector<HTMLButtonElement>('#prev-btn');
    const nextBtn = showcase?.querySelector<HTMLButtonElement>('#next-btn');

    if (!track || originalCards.length < 2) return;

    const cardCount = originalCards.length;
    const firstClone = originalCards[0].cloneNode(true) as HTMLElement;
    const lastClone = originalCards[cardCount - 1].cloneNode(true) as HTMLElement;

    [firstClone, lastClone].forEach((clone) => {
      clone.dataset.sliderClone = 'true';
      clone.setAttribute('aria-hidden', 'true');
      clone.setAttribute('inert', '');
    });

    track.prepend(lastClone);
    track.append(firstClone);

    const slides = Array.from(track.children) as HTMLElement[];
    const viewport = track.parentElement;
    let currentPosition = 2; // Start on the second real project.
    let isTransitioning = false;
    let transitionTimer: number | undefined;

    function logicalIndex() {
      return (currentPosition - 1 + cardCount) % cardCount;
    }

    function updateTransform() {
      if (!viewport) return;

      const viewportWidth = viewport.clientWidth;
      const cardWidth = slides[0].clientWidth;
      const gap = Number.parseFloat(window.getComputedStyle(track).columnGap) || 0;
      const offset = (viewportWidth - cardWidth) / 2 - currentPosition * (cardWidth + gap);
      track.style.transform = `translateX(${offset}px)`;
    }

    function updateIndicators() {
      const activeIndex = logicalIndex();
      dots.forEach((dot, idx) => {
        const isActive = idx === activeIndex;
        if (isActive) {
          dot.classList.remove('bg-slate-200', 'w-2.5');
          dot.classList.add('bg-slate-900', 'w-6');
        } else {
          dot.classList.remove('bg-slate-900', 'w-6');
          dot.classList.add('bg-slate-200', 'w-2.5');
        }
        dot.setAttribute('aria-pressed', String(isActive));
      });
    }

    function updateEmphasis() {
      slides.forEach((slide, idx) => {
        if (idx === currentPosition) {
          slide.style.opacity = '1';
          slide.style.transform = 'scale(1)';
        } else {
          slide.style.opacity = '0.4';
          slide.style.transform = 'scale(0.95)';
        }
      });
    }

    function updateSlider() {
      updateTransform();
      updateIndicators();
      updateEmphasis();
    }

    function finishTransition() {
      if (!isTransitioning) return;

      isTransitioning = false;
      if (transitionTimer !== undefined) {
        window.clearTimeout(transitionTimer);
        transitionTimer = undefined;
      }

      let snapToPosition: number | undefined;
      if (currentPosition === 0) snapToPosition = cardCount;
      if (currentPosition === cardCount + 1) snapToPosition = 1;

      if (snapToPosition !== undefined) {
        currentPosition = snapToPosition;
        track.style.transition = 'none';
        updateSlider();
        track.getBoundingClientRect();
        track.style.transition = '';
      }
    }

    function moveTo(position: number) {
      if (isTransitioning) return;

      currentPosition = position;
      isTransitioning = true;
      updateSlider();

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        finishTransition();
      } else {
        // Fallback in case a browser does not emit transitionend.
        transitionTimer = window.setTimeout(finishTransition, 650);
      }
    }

    function handleTransitionEnd(event: TransitionEvent) {
      if (event.target === track && event.propertyName === 'transform') {
        finishTransition();
      }
    }

    function handleDotClick(event: MouseEvent) {
      if (isTransitioning) return;

      const dot = event.currentTarget as HTMLButtonElement;
      const targetIndex = Number.parseInt(dot.dataset.slide ?? '', 10);
      if (!Number.isInteger(targetIndex) || targetIndex < 0 || targetIndex >= cardCount) return;

      const activeIndex = logicalIndex();
      if (targetIndex === activeIndex) return;
      if (activeIndex === cardCount - 1 && targetIndex === 0) {
        moveTo(cardCount + 1);
      } else if (activeIndex === 0 && targetIndex === cardCount - 1) {
        moveTo(0);
      } else {
        moveTo(targetIndex + 1);
      }
    }

    function handleNext() {
      moveTo(currentPosition + 1);
    }

    function handlePrevious() {
      moveTo(currentPosition - 1);
    }

    let touchStartX = 0;
    function handleTouchStart(event: TouchEvent) {
      touchStartX = event.changedTouches[0]?.screenX ?? 0;
    }

    function handleTouchEnd(event: TouchEvent) {
      const touchEndX = event.changedTouches[0]?.screenX ?? 0;
      const diffX = touchEndX - touchStartX;
      if (Math.abs(diffX) <= 50) return;

      if (diffX < 0) handleNext();
      else handlePrevious();
    }

    function handleResize() {
      updateTransform();
    }

    track.addEventListener('transitionend', handleTransitionEnd);
    track.addEventListener('touchstart', handleTouchStart, { passive: true });
    track.addEventListener('touchend', handleTouchEnd, { passive: true });
    dots.forEach((dot) => dot.addEventListener('click', handleDotClick));
    prevBtn?.addEventListener('click', handlePrevious);
    nextBtn?.addEventListener('click', handleNext);
    window.addEventListener('resize', handleResize);

    track.style.transition = 'none';
    updateSlider();
    track.getBoundingClientRect();
    window.requestAnimationFrame(() => {
      track.style.transition = '';
    });

    const cleanup = () => {
      if (transitionTimer !== undefined) window.clearTimeout(transitionTimer);
      track.removeEventListener('transitionend', handleTransitionEnd);
      track.removeEventListener('touchstart', handleTouchStart);
      track.removeEventListener('touchend', handleTouchEnd);
      dots.forEach((dot) => dot.removeEventListener('click', handleDotClick));
      prevBtn?.removeEventListener('click', handlePrevious);
      nextBtn?.removeEventListener('click', handleNext);
      window.removeEventListener('resize', handleResize);
      firstClone.remove();
      lastClone.remove();
      if (cleanupSlider === cleanup) cleanupSlider = undefined;
    };

    cleanupSlider = cleanup;
  }

  function cleanupBeforeSwap() {
    cleanupSlider?.();
  }

  setupSlider();
  document.addEventListener('astro:before-swap', cleanupBeforeSwap);
  document.addEventListener('astro:after-swap', setupSlider);
</script>
