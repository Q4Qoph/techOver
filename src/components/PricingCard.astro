---
interface Props {
  tier: string;
  price: string;
  description: string;
  features: string[];
  isPopular?: boolean;
}

const { tier, price, description, features, isPopular = false } = Astro.props;
---
<div class={`rounded-2xl p-8 bg-white border transition-all duration-300 hover:-translate-y-1.5 ${isPopular ? 'border-blue-600 shadow-xl hover:shadow-2xl relative ring-1 ring-blue-600' : 'border-gray-200 shadow-sm hover:shadow-md'}`}>
  {isPopular && <span class="absolute top-0 -translate-y-1/2 bg-blue-600 text-white px-3 py-0.5 rounded-full text-sm font-semibold tracking-wide shadow-sm">Most Popular</span>}
  <h3 class="text-xl font-semibold text-gray-900">{tier}</h3>
  <p class="mt-4 flex items-baseline text-4xl font-extrabold text-slate-900">
    KES {price}
  </p>
  <p class="mt-2 text-sm text-gray-500">{description}</p>
  <ul class="mt-6 space-y-4">
    {features.map((feature) => (
      <li class="flex items-start">
        <svg class="h-5 w-5 text-green-500 shrink-0" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
        </svg>
        <span class="ml-3 text-sm text-gray-700">{feature}</span>
      </li>
    ))}
  </ul>
  <div class="mt-8">
    <a 
      href={`https://wa.me/254798361771?text=Hi%20Fredie,%20I'm%20interested%20in%20the%20${encodeURIComponent(tier)}%20package.`}
      class={`w-full py-3 px-4 rounded-xl text-center font-bold text-sm block transition-all duration-300 ${
        isPopular 
          ? 'bg-blue-600 text-white hover:bg-blue-700 shadow-md shadow-blue-200 hover:shadow-lg hover:shadow-blue-300 hover:-translate-y-0.5 active:translate-y-0' 
          : 'bg-slate-50 text-slate-700 border border-slate-200 hover:bg-slate-100 hover:border-slate-350 hover:-translate-y-0.5 active:translate-y-0'
      }`}
    >
      Get Started
    </a>
  </div>
</div>