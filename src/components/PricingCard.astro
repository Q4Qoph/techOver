---
interface Props {
  tier: string;
  price: string;
  description: string;
  features: string[];
  isPopular?: boolean;
}

const { tier, price, description, features, isPopular = false } = Astro.props;
---
<div class={`rounded-2xl p-8 bg-white border ${isPopular ? 'border-blue-600 shadow-xl relative ring-1 ring-blue-600' : 'border-gray-200 shadow-sm'}`}>
  {isPopular && <span class="absolute top-0 -translate-y-1/2 bg-blue-600 text-white px-3 py-0.5 rounded-full text-sm font-semibold tracking-wide">Most Popular</span>}
  <h3 class="text-xl font-semibold text-gray-900">{tier}</h3>
  <p class="mt-4 flex items-baseline text-4xl font-extrabold text-slate-900">
    KES {price}
  </p>
  <p class="mt-2 text-sm text-gray-500">{description}</p>
  <ul class="mt-6 space-y-4">
    {features.map((feature) => (
      <li class="flex items-start">
        <svg class="h-5 w-5 text-green-500 shrink-0" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
        </svg>
        <span class="ml-3 text-sm text-gray-700">{feature}</span>
      </li>
    ))}
  </ul>
</div>