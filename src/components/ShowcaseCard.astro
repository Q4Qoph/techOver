---
import { Picture } from 'astro:assets';
import type { ShowcaseProject } from '../data/showcaseProjects';

interface Props {
  project: ShowcaseProject;
  index: number;
}

const { project, index } = Astro.props;
---

<article
  class="showcase-card w-[88vw] md:w-[760px] shrink-0 bg-slate-950 text-white rounded-[28px] md:rounded-[32px] p-5 sm:p-6 md:p-10 border border-slate-800 shadow-2xl flex flex-col justify-between transition-[transform,opacity] duration-500 ease-in-out"
  data-index={index}
  role="group"
  aria-roledescription="slide"
  aria-label={`${index + 1}: ${project.title}`}
>
  <div>
    <div class="mb-4 md:mb-6 text-left">
      <h3 class="text-xl sm:text-2xl md:text-3xl font-bold text-white mb-1 sm:mb-2">{project.title}</h3>
      <p class="line-clamp-2 text-xs md:line-clamp-none md:text-sm text-slate-400 font-light max-w-2xl leading-relaxed">
        {project.description}
      </p>
    </div>

    <div class="relative bg-slate-900 rounded-2xl overflow-hidden border border-slate-800 shadow-2xl aspect-[16/9] w-full group">
      <div class="relative w-full h-full overflow-hidden bg-slate-950">
        <Picture
          src={project.image}
          alt={project.imageAlt}
          formats={['avif', 'webp']}
          widths={[384, 640, 760, 1200, 1600]}
          sizes="(max-width: 768px) 88vw, 760px"
          quality={78}
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-102"
        />
        <div class="absolute inset-0 bg-slate-950/40 opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity duration-300 flex items-center justify-center backdrop-blur-[1px]">
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 bg-white text-slate-950 font-bold text-xs rounded-full shadow-2xl hover:scale-105 transition-transform duration-300 flex items-center gap-1.5"
            aria-label={`Visit ${project.title} website (opens in a new tab)`}
          >
            <span>Visit Live Site</span>
            <span class="text-[10px]" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</article>
