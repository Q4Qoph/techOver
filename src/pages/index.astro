---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ShowcaseSection from '../components/ShowcaseSection.astro';
import PricingCard from '../components/PricingCard.astro';
import WhatsAppFloatingCTA from '../components/WhatsAppFloatingCTA.astro';
---

<BaseLayout title="Fast Web Solutions for Kenyan SMEs">
  <Navbar />
  
  <main class="flex-grow pt-16">
    <Hero />

    {/* Section A: "How It Works" (3-Step Process) */}
    <section class="py-24 bg-white" id="how-it-works">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <span class="px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold tracking-wide uppercase">
            Simple Process
          </span>
          <h2 class="mt-4 text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
            How It Works
          </h2>
          <p class="mt-4 text-lg text-slate-600 max-w-2xl mx-auto">
            Get a high-performance website in 3 simple steps. We handle the technical details while you focus on running your business.
          </p>
        </div>
        
        <div class="relative grid md:grid-cols-3 gap-8 md:gap-12">
          {/* Step 1 */}
          <div class="relative flex flex-col p-8 bg-slate-50 rounded-2xl border border-slate-100 transition-all duration-300 hover:shadow-md hover:bg-slate-50/80">
            <div class="text-5xl font-black text-blue-600/20 mb-4 select-none">01</div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">Consultation &amp; Discovery (30 Mins)</h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              We define your business goals and key sales offer. No complex briefs, just a simple conversation about what makes you money.
            </p>
          </div>
          
          {/* Step 2 */}
          <div class="relative flex flex-col p-8 bg-slate-50 rounded-2xl border border-slate-100 transition-all duration-300 hover:shadow-md hover:bg-slate-50/80">
            <div class="text-5xl font-black text-blue-600/20 mb-4 select-none">02</div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">Rapid Build (3–5 Days)</h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              We build your fast Astro site with mobile-first design and M-Pesa readiness. Optimized for instant load times and lead capture.
            </p>
          </div>
          
          {/* Step 3 */}
          <div class="relative flex flex-col p-8 bg-slate-50 rounded-2xl border border-slate-100 transition-all duration-300 hover:shadow-md hover:bg-slate-50/80">
            <div class="text-5xl font-black text-blue-600/20 mb-4 select-none">03</div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">Launch &amp; Convert</h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              Go live, list on Google, and start routing leads directly to your WhatsApp or checkout. Begin converting traffic into paying clients immediately.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* Section B: Proof of Work / Showcase Grid */}
    <ShowcaseSection />

    {/* Pricing Grid */}
    <section class="py-24 bg-slate-50 border-t border-slate-100" id="pricing">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <span class="px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold tracking-wide uppercase">
            Pricing
          </span>
          <h2 class="mt-4 text-3xl md:text-4xl font-extrabold text-slate-900">Transparent Pricing for Kenyan Businesses</h2>
          <p class="mt-4 text-lg text-slate-600 max-w-2xl mx-auto">No hidden fees. Just high-performance code that drives sales.</p>
        </div>
        
        <div class="grid lg:grid-cols-3 md:grid-cols-2 gap-8">
          <PricingCard 
            tier="Starter SME Page" price="25,000" description="Perfect for service businesses establishing a fast online presence."
            features={["Lightning-Fast Single Page", "Direct WhatsApp Integration", "Basic SEO Setup", "Mobile-First Design", "Cloudflare Hosting"]} 
          />
          <PricingCard 
            tier="Growth E-Commerce" price="55,000" description="For businesses selling products that need automated payments." isPopular={true}
            features={["Multi-Page Catalog", "M-Pesa STK Push Integration", "Automated Lead Capture", "Advanced Technical SEO", "Inventory Dashboard setup"]} 
          />
          <PricingCard 
            tier="Custom Web App" price="85,000+" description="Full-stack solutions for unique operational workflows."
            features={["Custom Database Architecture", "Admin Portal Workflow", "Third-party API Integrations", "User Authentication", "Scalable Edge Deployment"]} 
          />
        </div>
      </div>
    </section>

    {/* Section C: Frequently Asked Questions (FAQ Accordion) */}
    <section class="py-24 bg-white border-t border-slate-100" id="faq">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <span class="px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold tracking-wide uppercase">
            FAQ
          </span>
          <h2 class="mt-4 text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
            Frequently Asked Questions
          </h2>
          <p class="mt-4 text-lg text-slate-600">
            Answering common concerns about launching websites for Kenyan SMEs.
          </p>
        </div>
        
        <div class="space-y-4">
          {/* FAQ 1 */}
          <details class="group border border-slate-200/80 rounded-2xl bg-white transition-all duration-300 open:shadow-lg open:border-blue-200" name="faq-accordion">
            <summary class="flex justify-between items-center font-bold text-slate-800 p-6 cursor-pointer list-none select-none">
              <span class="pr-4">Do I need a laptop to manage my orders?</span>
              <span class="transition-transform duration-300 group-open:rotate-180 text-blue-600 shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
              </span>
            </summary>
            <div class="px-6 pb-6 text-slate-600 border-t border-slate-100/50 pt-4 leading-relaxed text-sm md:text-base">
              No! We structure your website's lead capture and ordering workflow so that everything routes directly to your phone. Customer messages arrive instantly as a pre-filled WhatsApp chat or checkout confirmation. You can manage everything right from your mobile phone.
            </div>
          </details>
          
          {/* FAQ 2 */}
          <details class="group border border-slate-200/80 rounded-2xl bg-white transition-all duration-300 open:shadow-lg open:border-blue-200" name="faq-accordion">
            <summary class="flex justify-between items-center font-bold text-slate-800 p-6 cursor-pointer list-none select-none">
              <span class="pr-4">What are the recurring costs after building?</span>
              <span class="transition-transform duration-300 group-open:rotate-180 text-blue-600 shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
              </span>
            </summary>
            <div class="px-6 pb-6 text-slate-600 border-t border-slate-100/50 pt-4 leading-relaxed text-sm md:text-base">
              We keep your recurring costs to the absolute minimum. You only pay for your domain (approx. KES 1,000 to 1,500 per year). We host your Astro site on Cloudflare’s global edge network, which is 100% free and immune to heavy traffic spikes. No expensive monthly hosting plans.
            </div>
          </details>
          
          {/* FAQ 3 */}
          <details class="group border border-slate-200/80 rounded-2xl bg-white transition-all duration-300 open:shadow-lg open:border-blue-200" name="faq-accordion">
            <summary class="flex justify-between items-center font-bold text-slate-800 p-6 cursor-pointer list-none select-none">
              <span class="pr-4">Can customers pay directly via M-Pesa?</span>
              <span class="transition-transform duration-300 group-open:rotate-180 text-blue-600 shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
              </span>
            </summary>
            <div class="px-6 pb-6 text-slate-600 border-t border-slate-100/50 pt-4 leading-relaxed text-sm md:text-base">
              Yes! For e-commerce and retail setups, we integrate automatic STK Push checkout. When a customer enters their number on your site, they instantly get an M-Pesa PIN prompt on their phone to complete the payment. For starter setups, we can link standard direct Paybill/Till number instructions that pre-fill order details.
            </div>
          </details>
        </div>
      </div>
    </section>
  </main>

  {/* Footer */}
  <footer class="bg-slate-900 py-16 text-center text-slate-400 border-t border-slate-800 relative z-10">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex items-center justify-center gap-2 mb-4">
        <img src="/techover-logo.png" alt="techover.pro Logo" class="h-12 w-auto object-contain" />
        <p class="font-bold text-white text-xl">techover<span class="text-blue-500">.pro</span></p>
      </div>
      <p class="mb-2">📍 Nairobi / Mombasa, Kenya 🇰🇪</p>
      <p class="mb-8">Built by Fredie | SME Web Solutions | TikTok: @fredie.websolution</p>
      <p class="text-sm text-slate-500">© {new Date().getFullYear()} techover.pro. All rights reserved.</p>
    </div>
  </footer>

  <WhatsAppFloatingCTA />
</BaseLayout>