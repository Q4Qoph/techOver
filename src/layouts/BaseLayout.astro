---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "Get a lightning-fast, high-converting website built for Kenyan SMEs. Direct WhatsApp & M-Pesa checkout readiness." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO & Performance -->
    <title>{title} | techover.pro</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://techover.pro" />
    
    <!-- Open Graph for Social/WhatsApp Sharing -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://techover.pro" />
    <meta property="og:site_name" content="techover.pro - SME Web Solutions" />
    
    <style is:global>
      /* System fonts to completely eliminate font load times and layout shift */
      :root {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
      }
    </style>
  </head>
  <body class="bg-gray-50 text-gray-900 antialiased flex flex-col min-h-screen">
    <slot />
  </body>
</html>